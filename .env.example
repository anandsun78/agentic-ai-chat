# Kafka Configuration for Confluent Cloud
# Copy this file to .env and fill in your actual credentials

# Bootstrap Servers (comma-separated if multiple)
KAFKA_BOOTSTRAP_SERVERS=pkc-619z3.us-east1.gcp.confluent.cloud:9092

# Topic Name
KAFKA_TOPIC_NAME=team.team.08c7dfa9e986432d891385b64f410bba

# Consumer Group
KAFKA_CONSUMER_GROUP=team-cg-08c7dfa9e986432d891385b64f410bba

# Client ID
KAFKA_CLIENT_ID=team-client-08c7dfa9e986432d891385b64f410bba

# SASL Configuration
KAFKA_SASL_USERNAME=QRHNR6BCKVHD4M3U
KAFKA_SASL_PASSWORD=cfltTIivf3OHq6tr9fpASLxV4pp7vzPfvnz3cwT8+NAoOAJUCZwRuxuk1sSZTK+w
KAFKA_SASL_MECHANISM=PLAIN

# TLS Configuration
KAFKA_TLS_ENABLED=true
# Optional: use a unique group suffix for testing
# KAFKA_USE_UNIQUE_GROUP=false

# Agentic AI Chat Service API Configuration
AGENTIC_API_BASE_URL=https://your-api-base-url.com
AGENTIC_API_KEY=your-api-key-here

# Firebase Admin SDK (Server-side)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/service-account.json
# Or provide the JSON directly
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"..."}'

# Firestore collection names
FIREBASE_COLLECTION_KAFKA_EVENTS=kafka_events
FIREBASE_COLLECTION_KAFKA_MESSAGES=kafka_messages
FIREBASE_COLLECTION_KAFKA_TYPING_INDICATORS=kafka_typing_indicators
FIREBASE_COLLECTION_USERS=users

# Event + messaging defaults
DEFAULT_MESSAGE_SERVICE=iMessage
DEFAULT_MESSAGE_TYPE=message
DEFAULT_PROFILE_TYPE=unknown
EVENT_TYPE_MESSAGE_RECEIVED=message.received
EVENT_TYPE_MESSAGE_SENT=message.sent
EVENT_TYPE_TYPING_INDICATOR_RECEIVED=typing_indicator.received
EVENT_TYPE_TYPING_INDICATOR_REMOVED=typing_indicator.removed
EVENT_TYPE_UNKNOWN=unknown
FIREBASE_PERMISSION_DENIED_CODE=7

# Chatbot settings
CHATBOT_MODEL=claude-3-haiku-20240307
CHATBOT_MAX_CONTEXT_MESSAGES=20
CHATBOT_MIN_RESPONSE_LENGTH=5
CHATBOT_MAX_RESPONSE_LENGTH=150
CHATBOT_TEMPERATURE=0.9
CHATBOT_MAX_TOKENS=80
CHATBOT_LOG_PREVIEW_LENGTH=100
CHATBOT_HISTORY_WINDOW=10
CHATBOT_TRUNCATION_THRESHOLD_RATIO=0.5

# Kafka tuning (timeouts/retries)
KAFKA_CONNECTION_TIMEOUT_MS=3000
KAFKA_REQUEST_TIMEOUT_MS=30000
KAFKA_SESSION_TIMEOUT_MS=30000
KAFKA_HEARTBEAT_INTERVAL_MS=3000
KAFKA_MAX_IN_FLIGHT_REQUESTS=1
KAFKA_REBALANCE_TIMEOUT_MS=60000
KAFKA_RETRY_INITIAL_MS=100
KAFKA_RETRY_COUNT=8
KAFKA_CONSUMER_ERROR_BACKOFF_MS=5000

# Matching configuration
MATCHING_BASE_SCORE=50
MATCHING_MAX_SCORE=100
MATCHING_RESULTS_LIMIT=30
MATCHING_SCORED_PROFILES_LIMIT=20
MATCHING_SELECTION_MIN=5
MATCHING_SELECTION_MAX=8
MATCHING_SCORING_MODEL=claude-3-5-sonnet-20241022
MATCHING_SCORING_MAX_TOKENS=2000
MATCHING_SCORE_PROFESSION_MATCH=20
MATCHING_SCORE_LOCATION_MATCH=15
MATCHING_SCORE_SKILL_MATCH=5
MATCHING_SCORE_INTEREST_MATCH=10
MATCHING_SCORE_SPECIALTY_MATCH=15
MATCHING_SCORE_BIO_KEYWORD_MATCH=5
MATCHING_SCORE_TECH_BOOST=10
MATCHING_THRESHOLD_EXCELLENT=80
MATCHING_THRESHOLD_STRONG=70
MATCHING_THRESHOLD_GOOD=60
MATCHING_BIO_KEYWORD_MIN_LENGTH=4

# Server behavior
FIREBASE_INIT_DELAY_MS=1000
MESSAGE_PREVIEW_SHORT=50
MESSAGE_PREVIEW_LONG=100
CONVERSATION_FETCH_LIMIT=100
DEFAULT_PORT=8000
DEFAULT_HOST=0.0.0.0
MAX_BUFFERED_EVENTS=1000
